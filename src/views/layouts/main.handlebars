<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{titulo}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/css/variables.css" rel="stylesheet" />
  <link href="/css/navbar.css" rel="stylesheet" />
  <link href="/css/cards.css" rel="stylesheet" />
  <link href="/css/forms.css" rel="stylesheet" />
  <link href="/css/table.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100">

  <nav class="navbar navbar-expand-lg navbar-biocaqueta py-3">
    <div class="container">
      <a class="brand-wrapper" href="/">
        <span class="brand-mark">BC</span>
        <div>
          <span class="brand-title">BioCaquetá</span>
          <span class="brand-subtitle">Universidad de la Amazonia · Piedemonte Amazónico</span>
        </div>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
          <li class="nav-item">
            <a class="nav-link-bio active" href="/">Inicio</a>
          </li>
          <li class="nav-item">
            <a class="nav-link-bio" href="/api/avistamientos" target="_blank">Endpoint JSON</a>
          </li>
        </ul>

        <div class="d-flex flex-wrap align-items-center gap-2">
          <button type="button" class="status-pill {{#if dbStatus.connected}}status-pill-connected{{else}}status-pill-disconnected{{/if}}" data-bs-toggle="modal" data-bs-target="#modalMongoAtlas">
            <span class="status-dot {{#if dbStatus.connected}}status-dot-online{{else}}status-dot-offline{{/if}}"></span>
            <span>Atlas: {{dbStatus.stateText}}</span>
          </button>

          <button type="button" class="bio-btn bio-btn-amber bio-btn-sm" data-bs-toggle="modal" data-bs-target="#modalPostman">
            <span>Vincular Postman</span>
          </button>

          <a href="https://cloud.mongodb.com" target="_blank" rel="noopener" class="bio-btn bio-btn-outline bio-btn-sm">
            <span>Panel Atlas</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <main class="container my-4 flex-grow-1 page-shell">
    {{{body}}}
  </main>

  <div class="modal fade" id="modalMongoAtlas" tabindex="-1" aria-labelledby="modalMongoAtlasLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content bio-modal-content">
        <div class="modal-header bio-modal-header">
          <h5 class="modal-title fw-bold" id="modalMongoAtlasLabel">
            Conexión Dinámica a MongoDB Atlas (RF-01)
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <form action="/api/config/mongo" method="POST">
          <div class="modal-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 bio-alert {{#if dbStatus.connected}}bio-alert-success{{else}}bio-alert-danger{{/if}}">
              <div>
                <strong>Estado actual:</strong> {{dbStatus.stateText}}
                {{#if dbStatus.connected}}
                  <div class="small mt-1">Base de datos activa: <code>{{dbStatus.dbName}}</code> | Host: <code>{{dbStatus.host}}</code></div>
                {{/if}}
                {{#if dbStatus.lastError}}
                  <div class="small mt-1"><strong>Detalle:</strong> {{dbStatus.lastError}}</div>
                {{/if}}
              </div>
              <a href="https://cloud.mongodb.com" target="_blank" class="bio-btn bio-btn-outline bio-btn-sm">
                Abrir MongoDB Atlas
              </a>
            </div>

            {{#if dbStatus.maskedUri}}
              <div class="mb-3">
                <label class="bio-label">URI configurada actualmente en <code>.env</code>:</label>
                <div class="bio-info-box font-monospace small text-truncate">{{dbStatus.maskedUri}}</div>
              </div>
            {{/if}}

            <div class="mb-2">
              <label for="mongoUriInput" class="bio-label">
                Pegar o actualizar URI de MongoDB Atlas (<code>MONGO_URI</code>):
              </label>
              <input
                type="text"
                class="form-control bio-input font-monospace"
                id="mongoUriInput"
                name="mongoUri"
                placeholder="mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/biocaqueta_db?retryWrites=true&w=majority"
                required
              />
              <div class="form-text mt-2">
                Al guardar, la aplicación se conectará en caliente a la base de datos <code>biocaqueta_db</code> y actualizará tu archivo <code>.env</code> automáticamente.
              </div>
            </div>
          </div>
          <div class="modal-footer border-top-0 px-4 pb-4">
            <button type="button" class="bio-btn bio-btn-outline" data-bs-dismiss="modal">Cerrar</button>
            <button type="submit" class="bio-btn bio-btn-primary">
              Conectar y Guardar en .env
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalPostman" tabindex="-1" aria-labelledby="modalPostmanLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content bio-modal-content">
        <div class="modal-header bio-modal-header">
          <h5 class="modal-title fw-bold" id="modalPostmanLabel">
            Vinculación Dinámica con Postman (RF-02)
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body p-4">
          <div class="bio-info-box mb-3">
            <h6 class="fw-bold mb-1">Opción 1: Enlace dinámico para Postman</h6>
            <p class="small text-muted mb-2">
              Copia el enlace o descarga el archivo JSON con los endpoints <code>GET</code>, <code>POST</code>, <code>PUT</code> y <code>DELETE</code> sincronizados con el último <code>_id</code> registrado:
            </p>
            <div class="input-group">
              <input type="text" id="postmanLinkInput" class="form-control bio-input font-monospace" value="http://localhost:3000/api/postman-collection" readonly />
              <button class="bio-btn bio-btn-primary" type="button" onclick="copiarTexto('postmanLinkInput', this)">
                Copiar Link
              </button>
            </div>
          </div>

          <div class="bio-info-box mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
              <h6 class="fw-bold mb-1">Opción 2: Descargar archivo de Colección</h6>
              <p class="small text-muted mb-0">Descarga <code>BioCaqueta.postman_collection.json</code> listo para usar.</p>
            </div>
            <a href="/api/postman-collection?download=1" class="bio-btn bio-btn-soft">
              Descargar Colección (.json)
            </a>
          </div>

          <h6 class="fw-bold mt-3 mb-2">Endpoints REST implementados:</h6>
          <div class="table-responsive">
            <table class="table bio-table border">
              <thead>
                <tr>
                  <th>Método</th>
                  <th>Ruta</th>
                  <th>Función</th>
                </tr>
              </thead>
              <tbody>
                <tr class="bio-row">
                  <td><span class="badge-conservacion badge-menor">GET</span></td>
                  <td><code>/api/avistamientos</code></td>
                  <td>Consulta general ordenada por fecha descendente y filtro <code>?categoria=Ave</code></td>
                </tr>
                <tr class="bio-row">
                  <td><span class="badge-categoria cat-ave">POST</span></td>
                  <td><code>/api/avistamientos</code></td>
                  <td>Registra avistamiento (JSON retorna <code>201</code> / Formulario HTML redirige a <code>/</code>)</td>
                </tr>
                <tr class="bio-row">
                  <td><span class="badge-conservacion badge-vulnerable">PUT</span></td>
                  <td><code>/api/avistamientos/:id</code></td>
                  <td>Actualiza estado de conservación o zona (soporta <code>POST /update/:id</code>)</td>
                </tr>
                <tr class="bio-row">
                  <td><span class="badge-conservacion badge-peligro">DELETE</span></td>
                  <td><code>/api/avistamientos/:id</code></td>
                  <td>Elimina registro con <code>findByIdAndDelete</code> (soporta <code>POST /delete/:id</code>)</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="modal-footer border-top-0 px-4 pb-4">
          <button type="button" class="bio-btn bio-btn-outline" data-bs-dismiss="modal">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

  <footer class="footer-biocaqueta py-3 mt-auto">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center small">
      <div>
        <span class="footer-title">BioCaquetá</span> &mdash; Sistema de Monitoreo de Biodiversidad y Avistamientos del Piedemonte Amazónico
      </div>
      <div>
        Ingeniería de Sistemas · Universidad de la Amazonia (Florencia, Caquetá)
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('postmanLinkInput');
      if (input && window.location.origin) {
        input.value = window.location.origin + '/api/postman-collection';
      }
    });

    function copiarTexto(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      navigator.clipboard.writeText(input.value);
      const originalText = btn.innerText;
      btn.innerText = 'Copiado';
      setTimeout(() => {
        btn.innerText = originalText;
      }, 1800);
    }

    function copiarId(id, el) {
      navigator.clipboard.writeText(id);
      const original = el.innerText;
      el.innerText = 'ID copiado';
      setTimeout(() => {
        el.innerText = original;
      }, 1500);
    }
  </script>
</body>
</html>
